{
  "root": true,
  "env": { "es2022": true, "node": true, "browser": true },
  "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
  "rules": {
    "no-restricted-properties": [
      "error",
      {
        "object": "Math",
        "property": "random",
        "message": "Math.random is banned. Use rng.js (makeRng/deriveRng) instead — see SPEC.md §5.1."
      }
    ]
  }
}
